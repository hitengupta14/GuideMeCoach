{
  "expo": {
    "name": "guidemecoach-mobile",
    "slug": "guidemecoach-mobile",
    "version": "1.0.0",
    "scheme": "guidemecoach",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "com.anonymous.guidemecoachmobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8FAFC"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.guidemecoachmobile"
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GuideMeCoach to capture form videos and photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GuideMeCoach to upload workout photos."
        }
      ],
      "expo-av"
    ],
    "extra": {
      "eas": {
        "projectId": "40fa6cf7-bc49-4694-a61d-1a339bfea54a"
      }
    }
  }
}
