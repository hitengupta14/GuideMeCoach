# Public runtime configuration for the Expo app.
# Only variables prefixed with `EXPO_PUBLIC_` are embedded and available in the JS bundle.

# Production API base URL (should include `/api`; if you provide a domain only, the app will append `/api`)
EXPO_PUBLIC_API_URL="https://guidemecoach.com/api"

# Development API base URL.
# - iOS Simulator can use localhost: `http://localhost:3000/api`
# - Android Emulator uses host alias: `http://10.0.2.2:3000/api`
# - Physical device: use your machine's LAN IP: `http://192.168.x.x:3000/api`
EXPO_PUBLIC_DEV_API_URL="http://localhost:3000/api"

# Optional: enable verbose API/auth debug logs in development
EXPO_PUBLIC_API_DEBUG="false"

# Optional: override the Google OAuth web client id used by `expo-auth-session`
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="xxxx.apps.googleusercontent.com"
# Optional: platform-specific Google OAuth client ids (recommended for standalone builds)
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="xxxx.apps.googleusercontent.com"
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID="xxxx.apps.googleusercontent.com"

# Optional: Razorpay checkout logo URL (recommended for production polish)
# EXPO_PUBLIC_RAZORPAY_LOGO_URL="https://guidemecoach.com/logo.png"
