# =======================
# API Configuration
# =======================
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# =======================
# Database Configuration
# =======================
DATABASE_URL=postgresql://user:password@localhost:5432/guidemecoach

# =======================
# AWS S3 Configuration (for video storage)
# =======================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=guidemecoach-videos
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=https://your-bucket.s3.amazonaws.com

# =======================
# Stripe Configuration
# =======================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =======================
# Fitbit OAuth Configuration
# =======================
FITBIT_CLIENT_ID=your_fitbit_client_id
FITBIT_CLIENT_SECRET=your_fitbit_client_secret
FITBIT_REDIRECT_URI=http://localhost:3000/wearables/fitbit

# =======================
# Google OAuth Configuration
# =======================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/wearables/google

# =======================
# Apple Configuration
# =======================
APPLE_TEAM_ID=your_apple_team_id
APPLE_APP_ID=com.guidemecoach.mobile

# =======================
# Email Configuration
# =======================
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=your_resend_api_key
SMTP_FROM=noreply@guidemecoach.com

# =======================
# OpenAI Configuration (for AI features)
# =======================
OPENAI_API_KEY=sk_your_openai_api_key

# =======================
# Firebase Configuration (for push notifications)
# =======================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# =======================
# Mobile App Configuration
# =======================
REACT_APP_API_URL=http://localhost:3000/api/v1
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# =======================
# Environment
# =======================
NODE_ENV=development
