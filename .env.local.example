# Local development env example (web + mobile)

# URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Security
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
CRON_SECRET=""

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/guidemecoach"

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="GuideMeCoach <onboarding@resend.dev>"

# AI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Payments (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# OAuth (Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/wearables/google"

# Wearables (Fitbit)
ENABLE_WEARABLES="true"
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
FITBIT_REDIRECT_URI="http://localhost:3000/wearables/fitbit"

# Optional: encrypt wearable access/refresh tokens at rest (recommended).
# If not set, JWT_SECRET is used.
WEARABLE_TOKEN_ENCRYPTION_KEY=""
# Optional: previous key for rotation (allows decrypting old tokens)
WEARABLE_TOKEN_ENCRYPTION_KEY_OLD=""

# Video uploads (AWS S3-compatible)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
AWS_REGION="us-east-1"
AWS_S3_ENDPOINT="https://your-bucket.s3.amazonaws.com"

# Environment
NODE_ENV="development"
