# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/guidemecoach"
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="password"
DB_NAME="guidemecoach"

# Runtime & security
NODE_ENV="development"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
CRON_SECRET=""

# Safety toggles (guard destructive scripts)
ALLOW_SEED="false"
ALLOW_DESTRUCTIVE_SEED="false"
ALLOW_MIGRATION_CLEANUP="false"

# App URLs
APP_URL="https://guidemecoach.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION="development"

# AI
OPENAI_API_KEY="sk-proj-xxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# Email
RESEND_API_KEY=""
RESEND_FROM_EMAIL="GuideMeCoach <onboarding@resend.dev>"

# Monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
DATADOG_API_KEY=""

# Payments (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# OAuth (Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: allow verifying ID tokens from platform-specific OAuth clients
# GOOGLE_IOS_CLIENT_ID=""
# GOOGLE_ANDROID_CLIENT_ID=""
# Optional: comma-separated list of additional allowed Google OAuth client IDs (audiences)
# GOOGLE_ALLOWED_CLIENT_IDS=""

# Wearables
ENABLE_WEARABLES="true"
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
FITBIT_REDIRECT_URI="http://localhost:3000/wearables/fitbit"
GOOGLE_REDIRECT_URI="http://localhost:3000/wearables/google"

# Optional: encrypt wearable access/refresh tokens at rest (recommended).
# If not set, JWT_SECRET is used.
WEARABLE_TOKEN_ENCRYPTION_KEY=""
# Optional: previous key for rotation (allows decrypting old tokens)
WEARABLE_TOKEN_ENCRYPTION_KEY_OLD=""

# Video uploads (AWS S3-compatible)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
AWS_REGION="us-east-1"
AWS_S3_ENDPOINT="https://your-bucket.s3.amazonaws.com"
# Minimum required vars (baseline):
# - DATABASE_URL
# - JWT_SECRET
# - NEXT_PUBLIC_APP_URL
# - RESEND_FROM_EMAIL
#
# Commonly used:
# - RESEND_API_KEY
# - OPENAI_API_KEY
# - RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET
# - GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# - AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_S3_ENDPOINT
