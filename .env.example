# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/guidemecoach"
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="password"
DB_NAME="guidemecoach"

# Runtime & security
NODE_ENV="development"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Safety toggles (guard destructive scripts)
ALLOW_SEED="false"
ALLOW_DESTRUCTIVE_SEED="false"
ALLOW_MIGRATION_CLEANUP="false"

# App URLs
APP_URL="https://guidemecoach.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
REACT_APP_API_URL="http://localhost:3000/api/v1"
NEXT_PUBLIC_APP_VERSION="development"

# AI
OPENAI_API_KEY="sk-proj-xxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# Email
RESEND_API_KEY=""
RESEND_FROM_EMAIL="GuideMeCoach <onboarding@resend.dev>"

# Monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
DATADOG_API_KEY=""

# Payments (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# OAuth (Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Wearables
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
FITBIT_REDIRECT_URI="http://localhost:3000/wearables/fitbit"
GOOGLE_REDIRECT_URI="http://localhost:3000/wearables/google"

# Video uploads
AWS_S3_ENDPOINT="https://your-bucket.s3.amazonaws.com"



DATABASE_URL, JWT_SECRET, APP_URL (or NEXT_PUBLIC_APP_URL), RESEND_API_KEY, RESEND_FROM_EMAIL, RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, OPENAI_API_KEY, CRON_SECRET.
