# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/guidemecoach"

# Auth & Security
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
SESSION_SECRET="your-session-secret-key"
PASSWORD_RESET_SECRET="your-password-reset-secret"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NODE_ENV="development"

# OpenAI - AI-Powered Features (Required for AI chatbot & smart planner)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-xxxxxxxxxx"
# Recommended models:
# - gpt-4o-mini (recommended, fast & cheap: ~$0.15/1M input tokens)
# - gpt-4o (more powerful but pricier: ~$2.50/1M input tokens)
OPENAI_MODEL="gpt-4o-mini"

# Optional: Email Service
RESEND_API_KEY=""
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Optional: File Upload
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
S3_BUCKET_NAME=""
S3_REGION=""

# Analytics & Monitoring
SENTRY_DSN=""
GOOGLE_ANALYTICS_ID=""

# Feature Flags
ENABLE_CHAT_AI=false
ENABLE_FORM_ANALYSIS=false
ENABLE_PREMIUM=false
